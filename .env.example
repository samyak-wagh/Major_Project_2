# ═══════════════════════════════════════════════════════════════
#  OS Tutor — Environment Configuration
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ── Local Model (OS-Tutor) ──────────────────────────────────────
# The base TinyLlama model (~2.2 GB, downloaded from HuggingFace on first run)
LOCAL_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# The OS-tutor LoRA adapter (~50 MB, downloaded from HuggingFace on first run)
LOCAL_ADAPTER=rohit21789/OS-tutor

# ── Default PDF (auto-ingested on startup if knowledge base is empty) ──
DEFAULT_PDF=ostxtbook.pdf

# ── Qdrant Vector Database ──────────────────────────────────────
# For local Docker Qdrant (default — see start_local.bat):
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=os_tutor

# ── RAG Retrieval Settings ──────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SCORE_THRESHOLD=0.35

# ── Generation Settings ─────────────────────────────────────────
TEMPERATURE=0.1
MAX_NEW_TOKENS=512

# ── Evaluation Only (not used by main app) ──────────────────────
# Only needed if you run eval/run_eval.py
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_PAID_API_KEY=
