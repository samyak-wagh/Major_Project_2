# ═══════════════════════════════════════════════════════════════
#  OS Tutor — Environment Configuration
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ── Qwen2.5 Fine-tuned Model (PRIMARY local model) ──────────────────────────
QWEN_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# The OS-tutor LoRA adapter (already included in the repo)
LOCAL_ADAPTER_PATH=qwen-os-tutor-lora

# ── LLM Backend selector ────────────────────────────────────────────────────
# qwen  = Qwen2.5-1.5B + Yash LoRA  (PRIMARY, recommended, fully offline)
# local = TinyLlama + rohit21789    (secondary fallback)
# groq  = Groq cloud API            (cloud fallback)
LLM_BACKEND=qwen

# ── HuggingFace Cache Directory ─────────────────────────────────────────────
# Set this to a path with at least 5 GB of free space
HF_HOME=C:\Users\YourName\hf_cache

# ── Groq Cloud API (Fallback API) ───────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Legacy Local Model (TinyLlama - Optional) ───────────────────────────────
LOCAL_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
LOCAL_ADAPTER=rohit21789/OS-tutor

# ── Default PDF (auto-ingested on startup if knowledge base is empty) ───────
DEFAULT_PDF=ostxtbook.pdf

# ── Qdrant Vector Database ──────────────────────────────────────────────────
# For local Docker Qdrant (default — see start_local.bat):
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=os_tutor

# ── RAG Retrieval Settings ──────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3
SCORE_THRESHOLD=0.55
TEMPERATURE=0.1
MAX_NEW_TOKENS=2048
DEVICE=cpu

# ── Evaluation Only (not used by main app) ──────────────────────────────────
# Only needed if you run eval/run_eval.py
GEMINI_PAID_API_KEY=
